    <!-- Settings -->
    <string name="settings_title">Settings</string>
    <string name="settings_watch_link">Watch link</string>
    <string name="settings_nodes">Connected watches</string>
    <string name="settings_arrival_title">How a recording arrives</string>
    <string name="settings_arrival_body">The GalaxyVitals watch app writes a gzip CSV and pushes it to this phone over the Wear Data Layer. Android only delivers it when both apps share the application id app.galaxyvitals and the same signing key.</string>
    <string name="settings_watch_title">Galaxy Watch</string>
    <string name="settings_watch_body">Sideload the GalaxyVitals watch app onto a paired Galaxy Watch. Hardware ECG needs Samsung\'s official sensor library and a partner whitelist for app.galaxyvitals. Another vendor\'s companion app cannot talk to this one.</string>
    <string name="settings_import_title">Import</string>
    <string name="settings_import_body">You can import an ecg_*.csv.gz file from another source on the Home screen.</string>
    <string name="settings_model_title">Rhythm model</string>
    <string name="settings_model_body">After each recording the phone runs a rhythm model on the device itself. Once the signal passes the quality check, it sorts the 30-second single-lead strip into regular, irregular, or inconclusive. The score shown is the model\'s own confidence, not a diagnosis, and no rhythm is named.</string>
    <string name="settings_display_title">How the trace is drawn</string>
    <string name="settings_display_body">The strip is drawn at 25 mm/s and 10 mm/mV, the scale every clinical ECG is read at, after wrist orientation and a display-only filter. Numbers are measured at diagnostic bandwidth. The stored and exported ECG stays raw and unchanged.</string>
    <string name="settings_disclaimer_title">Disclaimer</string>
    <string name="settings_disclaimer_body">GalaxyVitals is not a medical device and does not diagnose conditions. If you feel unwell, seek professional care.</string>
